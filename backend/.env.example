# NextOwner backend configuration — copy to `.env` (gitignored) and fill in.
# Never commit real secrets. security.md §Secrets / §9.

# Database — SQLite locally; swap to a Postgres URL later (no code change).
DATABASE_URL=sqlite:///nextowner.db

# JWT — MUST be a strong random value (>=32 bytes) in any real environment.
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-change-me-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Login rate limiting (brute-force / credential-stuffing defence).
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Uploads (M2). UPLOAD_DIR is created on first write; keep it gitignored.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=12582912

# Leave false everywhere except tests — mounts the /_debug/boom route.
ENABLE_DEBUG_ROUTES=false

# Email channel (M8). MailHog locally: SMTP on 1025, inbox UI on http://localhost:8025.
# Set EMAIL_ENABLED=false to drop all mail (the NullEmailSender).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@nextowner.local
EMAIL_ENABLED=true
# Where links in outbound mail point. Server-owned — a client must never be able
# to influence the host in a reset link (that would be a phishing primitive).
APP_BASE_URL=http://localhost:5173

# Account-lifecycle tokens (M8). Short expiry is half the defence; single-use +
# hashed-at-rest is the other half (security.md §7 M8).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# Bounded harder than login: requesting a reset mails a THIRD PARTY on demand.
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# Notifications & saved searches (M8). The per-user search cap bounds the
# fan-out cost of one publication; the page limit is the browse DoS control.
SAVED_SEARCH_MAX_PER_USER=20
NOTIFICATIONS_PAGE_LIMIT=50
